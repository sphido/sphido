{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"includes": ["**", "!**/dist/**/*.*", "!**/.turbo", "!**/package.json"]
	},
	"formatter": {
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	}
}
