{
	"name": "@sphido/sitemap",
	"version": "4.0.0",
	"type": "module",
	"author": "Roman Ožana <roman@ozana.cz> (https://ozana.cz)",
	"homepage": "https://sphido.cz",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sphido/sphido.git",
		"directory": "packages/sphido-sitemap"
	},
	"description": "Sitemap XML for Sphido CMS",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/sitemap.d.ts",
			"default": "./dist/sitemap.js"
		}
	},
	"keywords": [
		"sphido",
		"sitemap"
	],
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@sphido/core": "workspace:*"
	},
	"devDependencies": {
		"@sindresorhus/slugify": "^3.0.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"test": "vitest run --passWithNoTests",
		"build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc"
	}
}
