{
	"name": "@sphido/core",
	"version": "3.1.1",
	"author": "Roman Ožana <roman@ozana.cz> (https://ozana.cz)",
	"homepage": "https://sphido.cz",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sphido/sphido.git",
		"directory": "packages/sphido-core"
	},
	"license": "MIT",
	"description": "A rocket 🚀 fast, lightweight, static site generator",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"keywords": [
		"markdown",
		"markup",
		"content management system",
		"cms",
		"static",
		"static site generator",
		"generator",
		"framework",
		"blog",
		"scaffold"
	],
	"bugs": "https://github.com/sphido/sphido/issues",
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@sindresorhus/slugify": "^3.0.0",
		"marked": "^18.0.9",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"test": "vitest run --passWithNoTests",
		"build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc"
	}
}
