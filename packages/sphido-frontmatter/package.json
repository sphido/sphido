{
	"name": "@sphido/frontmatter",
	"version": "3.1.0",
	"type": "module",
	"author": "Roman Ožana <roman@ozana.cz> (https://ozana.cz)",
	"homepage": "https://sphido.cz",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sphido/sphido.git",
		"directory": "packages/sphido-frontmatter"
	},
	"description": "Frontmatter for Sphido - A rocket 🚀 fast, lightweight, static site generator",
	"license": "MIT",
	"sideEffects": false,
	"keywords": [
		"markdown",
		"sphido",
		"frontmatter"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/frontmatter.d.ts",
			"default": "./dist/frontmatter.js"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"test": "vitest run --passWithNoTests",
		"build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc"
	},
	"dependencies": {
		"@sphido/core": "workspace:*",
		"js-yaml": "^4.2.0"
	}
}
